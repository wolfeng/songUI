{
  "name": "song-ui-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:tokens": "npm run build --workspace=@wolfeng/song-ui-tokens",
    "build:core": "npm run build --workspace=@wolfeng/song-ui-core",
    "build:ui": "npm run build --workspace=@wolfeng/song-ui-vue",
    "build": "npm run build:tokens && npm run build:core && npm run build:ui",
    "test": "npm run test --workspaces --if-present",
    "dev:docs": "npm run dev --workspace=@wolfeng/song-ui-docs",
    "build:docs": "npm run build --workspace=@wolfeng/song-ui-docs",
    "record:gifs": "node ./scripts/record-component-gifs.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
